{
  "name": "@sap-cloud-sdk/samples",
  "version": "0.0.1",
  "description": "SAP Cloud SDK for JS - Examples on Resilience",
  "author": "Frank Essenberger",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "npm run generate-client",
    "lint": "eslint \"src/**/*.ts\" && yarn prettier .",
    "lint:fix": "eslint \"src/**/*.ts\" --fix && yarn prettier . -w",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "generate-client": "npx generate-odata-client --input resources/service-specs --outputDir src/generated --clearOutputDir --transpile=false --optionsPerService=resources/service-specs/options-per-service.json"
  },
  "dependencies": {
    "@sap-cloud-sdk/odata-v2": "^4.2.0",
    "@sap-cloud-sdk/http-client": "^4.2.0",
    "@sap-cloud-sdk/connectivity": "^4.2.0",
    "@sap-cloud-sdk/util": "^4.2.0",
    "@sap-cloud-sdk/resilience": "^4.2.0",
    "@sap-cloud-sdk/generator": "^4.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@sap-cloud-sdk/eslint-config": "^4.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.2.1",
    "eslint-plugin-jsdoc": "^61.4.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-regex": "^1.10.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "30.2.0",
    "nock": "^14.0.10",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
