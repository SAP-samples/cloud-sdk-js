    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5",
    "@sap/xsenv": "^6.0.0",
    "cfenv": "^1.2.4",
    "@sap-cloud-sdk/util": "^4.2.0",
    "@sap-cloud-sdk/connectivity": "^4.2.0",
    "@sap-cloud-sdk/http-client": "^4.2.0",
    "@types/node": "^24.10.1",
    "ts-node": "^10",
    "typescript": "~5.9.3"
  },
  "devDependencies": {},
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  }
}
